# Mahalliy ishga tushirish uchun: .env.local nomi bilan nusxalang. Railway'da Variables bo'limiga yoziladi.

# PostgreSQL (Railway'da Postgres qo'shilganda ${{Postgres.DATABASE_URL}} deb ulanadi)
DATABASE_URL=postgres://postgres@localhost:5432/aqilli

# Sessiya imzosi uchun uzun tasodifiy matn (kamida 32 belgi tavsiya etiladi)
SESSION_SECRET=

# Birinchi rahbar (faqat baza bo'sh bo'lganda yaratiladi; keyin parolni Profil'dan o'zgartiring)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Telegram bot (@BotFather) — ixtiyoriy
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Soliq Monitor dasturi uchun kalit (kamida 16 belgi) — ixtiyoriy
MONITOR_KEY=

# Telegram xabarlaridagi sayt havolasi (Railway domeni bo'lsa avtomatik)
SITE_URL=
